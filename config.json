{
  "listen_host": "0.0.0.0",
  "listen_port": 8080,
  "strategy": "round_robin",
  "timeout": 5,
  "max_retries": 2,
  "log_file": "logs/access.log",
  "log_stdout": true,
  "health_check": {
    "enabled": true,
    "interval": 3,
    "timeout": 1,
    "path": "/health",
    "unhealthy_threshold": 3,
    "healthy_threshold": 2
  },
  "rate_limit": {
    "enabled": false,
    "capacity": 20,
    "refill_rate": 10
  },
  "backends": [
    {"host": "127.0.0.1", "port": 8001, "weight": 1},
    {"host": "127.0.0.1", "port": 8002, "weight": 1},
    {"host": "127.0.0.1", "port": 8003, "weight": 2}
  ]
}
